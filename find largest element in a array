import java.util.Scanner;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];

        
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int large = arr[0];
        for (int i = 1; i < n; i++) {
            if (large < arr[i]) {
                large = arr[i];
            }
        }

        System.out.println(large);
    }
}
