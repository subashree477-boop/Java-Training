import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n;
         n = sc.nextInt();
         int pdt = 1;

          int org = n; 

           while (n > 0) {
            int s = n % 10; 
            pdt *= s;     
            n /= 10;           
        }

        System.out.println("Product of digits of " + org + " is: " + pdt);
    }
}
