import java.util.Scanner;

public class ReverseNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        sc.close();

        int reversed = 0;
        while (N > 0) {
            reversed = reversed * 10 + N % 10;
            N /= 10;
        }

        System.out.println(reversed);
    }
}
   
