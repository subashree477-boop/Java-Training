import java.util.*;

public class Solution {
    public static void main(String[] args) {
        int N = new Scanner(System.in).nextInt();

        for (int i = 1; i <= N; i++) {
            for (int j = 1; j <= i; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
