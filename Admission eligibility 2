import java.util.Scanner;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int age = sc.nextInt();
        int marks = sc.nextInt();

        if (age >= 18) {           
            if (marks >= 40) {         
                System.out.println("Eligible");
            } else {
                System.out.println("Not eligible");
            }
        } else {
            System.out.println("Not eligible");
        }


    }
}
